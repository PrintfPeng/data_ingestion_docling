# =====================================================================
# .env.example  (Preset for OpenRouter single-user prototype)
#
# วิธีใช้:  cp .env.example .env  แล้ว nano .env ใส่ค่าจริง
# ไฟล์ .env ไม่ถูก commit ขึ้น git (มีใน .gitignore แล้ว)
# บน server หลังใส่ค่า:  chmod 600 .env
# =====================================================================

# ---------------------------------------------------------------------
# LLM หลัก (Text) — ผ่าน OpenRouter
# ---------------------------------------------------------------------
# 1. สมัคร/login ที่ https://openrouter.ai/keys แล้วสร้าง key (ขึ้นต้นด้วย sk-or-v1-...)
# 2. ตั้ง credit limit ที่ https://openrouter.ai/settings/credits (แนะนำ $10 สำหรับ prototype)
# 3. เช็คราคา + model list ล่าสุด: https://openrouter.ai/models
CUSTOM_API_KEY=sk-or-v1-REPLACE_ME
CUSTOM_API_BASE=https://openrouter.ai/api/v1

# --- Text model ---
# 🥇 แนะนำเริ่มต้น (ภาษาไทยดีที่สุด, JSON ดี)
CUSTOM_MODEL_NAME=qwen/qwen-2.5-72b-instruct
# 🥈 ทางเลือกประหยัดครึ่ง:  deepseek/deepseek-chat
# 🥉 ทางเลือกเร็ว + ถูก:    google/gemini-2.0-flash-001

# ---------------------------------------------------------------------
# Vision model — ใช้ผ่านโค้ดใน table_extractor.py + image_extractor.py
# (ต้องแก้ค่าใน code เพิ่ม; ดู VISION_MODEL constants ในไฟล์ทั้งสอง)
# ---------------------------------------------------------------------
# 🥇 qwen/qwen2.5-vl-72b-instruct   (อ่านตารางไทยเก่ง แต่แพง ~$0.70/M)
# 🥈 google/gemini-2.0-flash-001    (ถูก, multimodal, JSON ดี)
# 🥉 openai/gpt-4o-mini             (ไทยพอใช้ แต่เก่งดึงข้อมูลจากภาพ)

# ---------------------------------------------------------------------
# Google Gemini (Optional - fallback + free vision tier)
# ---------------------------------------------------------------------
# ปล่อยว่างไว้ได้ - ระบบจะ skip เงียบๆ ถ้าไม่ใส่
# ขอฟรีที่: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---------------------------------------------------------------------
# OCR API (Softnix internal - ถ้าไม่มีให้ปล่อยว่าง / ระบบจะข้าม OCR ภายนอก)
# ---------------------------------------------------------------------
# หมายเหตุ: Docling มี Tesseract OCR built-in อยู่แล้ว
#          ตัวนี้เป็นแค่ external booster - ถ้า server เข้า Softnix ไม่ได้ให้ปล่อยว่าง
#          แล้วรัน ingestion ด้วย --no-ocr
OCR_API_URL=
OCR_USERNAME=
OCR_PASSWORD=
VERIFY_SSL=False
